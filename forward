# NAT the matching packets to the destination
# packets match if they have the correct protocol, destination port, and target a local IP address as their destination
# append is used (instead of insert) so that new rules do not break existing ones (though this should be detected by input validation)
def port_rewrite(source_port, destination_address, destination_port, protocol):
    cmd = f"iptables {scope('nat')} {append('portforward')} -m addrtype --dst-type LOCAL -p {protocol} --dport {source_port} -j DNAT --to {destination_address}:{destination_port}"
    #print(cmd)
    out, code = system(cmd)
    #print(out, code)
    return (code == 0)

# accept the forwarding of the packet
def port_forward(source_port, destination_address, destination_port, protocol):
    cmd = f"iptables {append('portforward')} -p {protocol} -d {destination_address} --dport {destination_port} -j ACCEPT"
    #print(cmd)
    out, code = system(cmd)
    #print(out, code)
    return (code == 0)

# custom rule for local traffic (from localhost to localhost)
# local traffic does not go through the PREROUTING chain
# instead, use the OUTPUT table to redirect from localhost to the destination
# TODO: test sysctl -w net.ipv4.conf.all.route_localnet=1 to allow local traffic to go outside
def port_forward_local(source_port, destination_address, destination_port, protocol):
    # example: iptables -t nat -A OUTPUT -p tcp -d 127.0.0.1 --dport {src_port} -j DNAT --to-destination {dest_addr}:{dest_port}
    cmd = f"iptables {scope('nat')} {append('portforward-local')} -p {protocol} -m addrtype --dst-type LOCAL --dport {source_port} -j DNAT --to-destination {destination_address}:{destination_port}"
    out, code = system(cmd)
    return (code == 0)


# packets that were sent through portforward-local must be masqueraded so that the localhost source ip address is replaced by the host machine
# here, MASQUERADE is applied to all traffic going from the host (local traffic) to the destination of a port forward
# this includes forwarded traffic that went through the OUTPUT/portforward-local chain, but also includes normal traffic sent to the destination, such as:
# curl <destination_ip>:<destination_port>
# in this case, MASQUERADE incurs a small performance cost for (S)NAT-ing the local ip address with itself, but I found no better way to fix the local->local traffic that did not involve future maintenance or bugs.

# make the source of the traffic appear to be the port forwarding machine for the destination
# helps routing back the traffic when the source is localhost (without that, the destination seems to try to route back to localhost)
def nat_masquerade(source_port, destination_address, destination_port, protocol):
    # example: iptables -t nat -A POSTROUTING -m addrtype --src-type LOCAL -d {destination_addr} -p tcp --dport {dest_port} -j MASQUERADE
    cmd = f"iptables {scope('nat')} {append('portforward-masquerade')} -m addrtype --src-type LOCAL -d {destination_address} -p {protocol} --dport {destination_port} -j MASQUERADE"
    out, code = system(cmd)
    return (code == 0)



def is_localnet_routing_enabled():
    # check localnet routing, needed for localhost->localhost:<forwarded port>-><destination>:<port> traffic
    read_cmd = "sysctl net.ipv4.conf.all.route_localnet"
    out, code = system(read_cmd)
    assert code == 0, "critical error (aborting before modifying the system)"
    return (out == "net.ipv4.conf.all.route_localnet = 1\n")

# TODO: use /etc/sysctl.d/ to make this setting persistent (instead of modifying the system at runtime)
def enable_localnet_routing():
    write_cmd = "sysctl -w net.ipv4.conf.all.route_localnet=1"
    out, code = system(write_cmd)
    return (code == 0)

# TODO: adde persistence with /etc/sysctl.d/
def disable_localnet_routing():
    write_cmd = "sysctl -w net.ipv4.conf.all.route_localnet=0"
    out, code = system(write_cmd)
    return (code == 0)


