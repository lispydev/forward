def parse_args(argv):
    """
    manual arg parsing

    the only accepted argument forms are:
    forward --help
    forward help
    forward add|list|del [...args]
    """
    if len(argv) < 2:
        usage()

    match argv[1]:
        case "--help" | "help":
            usage()
        case "add":
            parse_add_args(argv[2:])
            sys.exit(0)
            #add_args = parse_add(argv)
            #return add, add_args
        case "list":
            # ignore other arguments for now
