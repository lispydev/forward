    def append_to(self, chain, table=None):
        return f"-t {scope(table)} -A {chain} {str(self)}"

    def delete_from(self, chain, table=None):
        return f"-t {scope(table)} -D {chain} {str(self)}"

def jump(chain):
    return f"-j {chain}"

# TODO: include scope() ?
def append(chain):
    return f"-A {chain}"

def insert(chain, position=1):
    if position is None:
        position = 1
    return f"-I {chain} {position}"

# delete rule by index
# TODO: never use this, as this is more error-prone than delete()
def delete_index(chain, position):
    return f"-D {chain} {position}"

# delete rule by rule spec
# (helper for command generation)
def delete(chain):
    return f"-D {chain}"


# insert chains into filter/FORWARD and nat/PREROUTING
def insert_chain_jump(where, chain, table=None):
    cmd = f"iptables {scope(table)} {insert(where)} {jump(chain)}"
    #print(cmd)
    out, code = system(cmd)
    return code == 0

def delete_chain_jump(where, chain, table=None):
    cmd = f"iptables {scope(table)} {delete(where)} {jump(chain)}"
    #print(cmd)
    out, code = system(cmd)
    return code == 0


