def define_chains():
    if not chain_exists("portforward"):
        create_chain("portforward")
        assert chain_exists("portforward")
        insert_chain_jump("FORWARD", "portforward")
    # NAT the traffic and rewrite the destination
    if not chain_exists("portforward", table="nat"):
        create_chain("portforward", "nat")
        assert chain_exists("portforward", "nat")
        insert_chain_jump("PREROUTING", "portforward", "nat")
    # rules for local traffic
    if not chain_exists("portforward-local", table="nat"):
        create_chain("portforward-local", "nat")
        assert chain_exists("portforward-local", "nat")
        insert_chain_jump("OUTPUT", "portforward-local", "nat")
    # rewrite the source for the destination when the source is localhost
    # (DNAT does not do this on its own)
    if not chain_exists("portforward-masquerade", table="nat"):
        create_chain("portforward-masquerade", "nat")
        assert chain_exists("portforward-masquerade", "nat")
        insert_chain_jump("POSTROUTING", "portforward-masquerade", "nat")


def remove_chains():
    if chain_exists("portforward"):
        #cmd = f"iptables -D FORWARD -t filter -j portforward"
        delete_chain_jump("FORWARD", "portforward")
        delete_chain("portforward")
    if chain_exists("portforward", table="nat"):
        delete_chain_jump("PREROUTING", "portforward", "nat")
        delete_chain("portforward", "nat")
    if chain_exists("portforward-local", table="nat"):
        delete_chain_jump("OUTPUT", "portforward-local", "nat")
        delete_chain("portforward-local", "nat")
    if chain_exists("portforward-masquerade", table="nat"):
        delete_chain_jump("POSTROUTING", "portforward-masquerade", "nat")
        delete_chain("portforward-masquerade", "nat")
    assert not chain_exists("portforward")
    assert not chain_exists("portforward", "nat")
    assert not chain_exists("portforward-local", "nat")
    assert not chain_exists("portforward-masquerade", "nat")


