def parse_args(argv):
    """
    manual arg parsing

    the only accepted argument forms are:
    forward --help
    forward help
    forward add|list|del [...args]
    """
    if len(argv) < 2:
        usage()

    match argv[1]:
        case "--help" | "help":
            usage()
        case "add":
            add_args = parse_add(argv)
            return add, add_args
        case "list":
            # ignore other arguments for now
            # TODO: parse forms such as "forward list tcp"
            return print_rules, []
        case "del":
            return remove, parse_del(argv)
        case default:
            usage()

