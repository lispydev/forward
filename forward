# helpers for db parsing
# db scheme:
# "source_port": "destination_address:destination_port[/protocol]"
def read_db_portforward_rule(source_port, destination_string):
    # parse protocols
    result = destination_string.split("/")
    if len(result) == 1:
        protocols = ["udp", "tcp"]
    elif len(result) == 2:
        protocols = [result[1]]
        destination_string = result[0]
    else:
        raise ValueError("Error when parsing the database")

    # parse the port
    result = destination_string.split(":")
    if len(result) == 1:
        destination_address = destination_string
        destination_port = source_port
    elif len(result) == 2:
        destination_address = result[0]
        destination_port = result[1]
    else:
        raise ValueError("Error when parsing the database")

    return PortForward(
            source_port=source_port,
            destination_address=destination_address,
            destination_port=destination_port,
            protocols=protocols,
    )


def write_db_portforward_rule(portforward):
    destination = f"{portforward.destination_address}:{portforward.destination_port}"
    if len(portforward.protocols) == 1:
        destination += f"/{portforward.protocols[0]}"
    return (portforward.source_port, destination)


# read the db and return a list of PortForward descriptors
#def read_port_forwards():
def list_ports():
    config = read_db()
    ports = []
    for source_port, destination in config["ports"].items():
        ports.append(read_db_portforward_rule(source_port, destination))

    return ports

