        assert empty_chain("portforward")
    if chain_exists("portforward", "nat"):
        assert empty_chain("portforward", "nat")
    if chain_exists("portforward-local", "nat"):
        assert empty_chain("portforward-local", "nat")
    if chain_exists("portforward-masquerade", "nat"):
        assert empty_chain("portforward-masquerade", "nat")
    # cleanup chains
    remove_chains()


