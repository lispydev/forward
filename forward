# argument parsing ("port ... to ...:... proto ...", "del port ...")

# sub-parsers for "port <port>", "to <destination>", "proto <proto>"
def parse_port_args(argv, cursor: int):
    if cursor + 1 >= len(argv):
        print("argparsing debug: no port")
        return None
    if argv[cursor] != "port":
        return None
    value = argv[cursor + 1]
    return int(value)

def parse_to_args(argv, cursor: int):
    if cursor + 1 >= len(argv):
        print("argparsing debug: no to")
        return None
    if argv[cursor] != "to":
        return None
    destination = argv[cursor + 1]
    # TODO: use a regex ?
    if ":" in destination:
        dest_ip, dest_port = destination.split(":")
        dest_port = int(dest_port)
    else:
        dest_ip, dest_port = destination, None
    dest_ip_parts = dest_ip.split(".")
    assert len(dest_ip_parts) == 4
    for part in dest_ip_parts:
        assert 0 <= int(part) <= 255
    return dest_ip, dest_port

def parse_proto_args(argv, cursor: int):
    if cursor + 1 >= len(argv):
        print("argparsing debug: no proto")
        return None
    if argv[cursor] != "proto":
        return None
    proto = argv[cursor + 1]
    assert proto in ["udp", "tcp"]
    return proto


